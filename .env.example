# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth Web client (see docs/oauth-setup.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# App URL (local or Vercel)
# AUTH_URL=http://localhost:3000
# AUTH_URL=https://YOUR_APP.vercel.app

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Supabase (server-only). Optional — without these, triage still works but nothing is saved.
# Project URL only, e.g. https://xxxxx.supabase.co  (NOT .../rest/v1)
# Settings → API → Project URL + service_role key
# Then run supabase/schema.sql in the SQL Editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
